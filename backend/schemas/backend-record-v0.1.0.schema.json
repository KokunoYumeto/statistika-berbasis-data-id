{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/openintro-statistics-id/schemas/backend-record-v0.1.0.schema.json",
  "title": "OpenIntro Statistics Indonesian modular-backend record",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "record_type",
    "id",
    "stable_key",
    "status",
    "recorded_at",
    "workflow_id"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/backend-record-v0.1.0.schema.json"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "enum": [
        "program",
        "course",
        "resource",
        "edition",
        "unit",
        "concept",
        "segment",
        "localization",
        "term",
        "asset",
        "relation",
        "rights",
        "qa_event",
        "artifact",
        "correction"
      ]
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "stable_key": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "edition_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "source_local_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "parent_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "order": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "source_path": {
      "type": ["string", "null"]
    },
    "source_span": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["line_start", "line_end", "byte_start", "byte_end_exclusive"],
          "properties": {
            "line_start": {"type": "integer", "minimum": 1},
            "line_end": {"type": "integer", "minimum": 1},
            "byte_start": {"type": "integer", "minimum": 0},
            "byte_end_exclusive": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "source_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "locale": {
      "type": ["string", "null"]
    },
    "translation_state": {
      "enum": [
        null,
        "source_frozen",
        "queued",
        "draft",
        "translated",
        "structurally_verified",
        "mathematically_reviewed",
        "language_reviewed",
        "built",
        "visually_checked",
        "published",
        "superseded",
        "blocked"
      ]
    },
    "rights_component_ids": {
      "type": "array",
      "items": {"type": "string", "format": "uuid"},
      "uniqueItems": true
    },
    "status": {
      "enum": ["active", "queued", "planned", "passed", "failed", "blocked", "superseded"]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "supersedes_id": {
      "type": ["string", "null"],
      "format": "uuid"
    }
  },
  "additionalProperties": true
}
